# Datasets — downloaded on demand, not committed.
# Rules are glob-style so negations can re-include LICENSE.md under ignored trees.
data/**
!data/**/
!data/**/LICENSE.md
*.zip
*.tar
*.tar.gz

# Model artifacts — large, trained locally
models/
runs/
*.pt
*.onnx
*.hef
*.har
*.ncnn.bin
*.ncnn.param
*_ncnn_model/

# Outputs
reports/**
!reports/.gitkeep
*.csv

# Runtime logs (Hailo PCIe driver writes hailort.log into cwd on the Pi)
hailort.log

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv-*/
venv/
.env
.env.*
*.egg-info/
dist/
build/
.ipynb_checkpoints/

# Session / tooling state
.remember/
.claude/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
